entity A enum ["foo", "bar"];
entity B = {
  "level": Long,
};
entity C;

action a appliesTo {
  principal: [A],
  resource: [B],
  context: {
    "flag": Bool,
    "who": A,
    "limit"?: Long,
  }
};

action b appliesTo {
  principal: [B, C],
  resource: [A],
};

action c appliesTo {
  principal: [A],
  resource: [B],
  context: {
    "flag": Bool,
  }
};
